# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ============================================================
# 数据库（本地部署必看）
# ============================================================
# DB_MODE:
#   local  -> 直连下面的 DATABASE_URL（本地/自建 PostgreSQL，推荐本地部署）
#   cloud  -> 走云端 TCB（沙箱环境自动配置，本地一般不用）
# 本地部署时请改为 local 并填写 DATABASE_URL。
DB_MODE=local

# PostgreSQL 连接串。先创建数据库：createdb nexus
# 也支持直接指向云端数据库外网连接串，实现本地与云端数据互通。
DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/nexus

# ============================================================
# AI 接入（两种用法，二选一）
# ============================================================
# 用法 A（默认·零配置试用）：连“站长托管中继”，下载者不用自己申请 key。
#   - AI_API_BASE 填站长的中继地址（把下面的域名改成你自己的公网地址）
#   - AI_API_KEY 填站长公开的 bot token（即下方 AI_BOT_TOKEN 的值，可公开、可随时重置，不含真实计费 key）
#   说明：流量和费用都算站长的，所以中继端已按 IP 限流防刷。
AI_API_BASE=https://nexus.yourdomain.com/api/ai/v1
AI_API_KEY=nexus-public-demo

# 用法 B（自带 key，无限流、最稳）：去 https://openrouter.ai/keys 申请，填入下方两行，注释掉上面的用法 A
# AI_API_BASE=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-你的key

# 以下模型名一般不用改
AI_MODEL=z-ai/glm-5.2:free
AI_VISION_MODEL=dots-studio/dots-3-note-preview:free
AI_VISION_FALLBACKS=stealth/space-bunny-alpha,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free

# ===== 仅“托管中继的站长”需要设置（下载者不用管）=====
# 托管端：填你真实的 OpenRouter key，并设一个公开 bot token（与上面下载者填的 AI_API_KEY 一致）
# AI_API_KEY=sk-or-站长的真实key
# AI_BOT_TOKEN=nexus-public-demo
# 开启 AI_BOT_TOKEN 后即进入“公开中继模式”：下载者必须注册登录后领取每日额度，不再裸奔。
# 真 key 只在你（站长）的服务器，下不到别人电脑，不会泄露。
# 每日配额与匿名试用额度（按 IP），可按需调整：
# RELAY_DAILY_LIMIT=20        # 每个注册账号每天免费对话次数
# RELAY_TRIAL_PER_IP=5        # 未登录访客每 IP 每天试用次数（引导注册）
