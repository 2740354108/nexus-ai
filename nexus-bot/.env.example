# ===== NEXUS BOT 配置示例 =====
# 复制本文件为 .env 后填写。所有项都有默认值，不填也能以最小形态启动（仅启用已配 token 的平台）。

# ---------- 对话核心（复用 NEXUS 同款模型） ----------
# OpenRouter 密钥：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxx
# 接口地址（一般不用改）
OPENROUTER_BASE=https://openrouter.ai/api/v1
# 使用的模型
BOT_MODEL=z-ai/glm-5.2
# Bot 人设（系统提示词）：填了就用你写的，不填则用代码里的默认人设。改这里即可换角色，无需动代码。
BOT_SYSTEM_PROMPT=
# 微信专属人设（阿枢）：留空则用内置的陪伴搭子人设；想自定义微信里的角色就填这里（记忆/报喜逻辑不受影响）。
WECHAT_SYSTEM_PROMPT=

# 单轮会话记忆保留的消息条数（含系统提示之外）
BOT_HISTORY_LIMIT=20

# ---------- 平台总开关 ----------
# 设为 true 才启用对应适配器；不配或 false 则不启动该平台
ENABLE_TELEGRAM=false
ENABLE_DISCORD=false
ENABLE_WECOM=false
ENABLE_WECHAT_MP=false
ENABLE_QQ=false

# ---------- Telegram（本地轮询，无需公网） ----------
# @BotFather 申请：https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# ---------- Discord ----------
# 开发者后台创建 Bot：https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ---------- 企业微信 ----------
# 方式一：群机器人 webhook（仅发送，最简单）
WECOM_WEBHOOK_URL=
# 方式二：企业应用接收消息（需公网回调，可双向对话）
WECOM_CORPID=
WECOM_AGENTID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# 接收消息的本地回调端口（需公网可访问）
WECOM_CALLBACK_PORT=8788

# ---------- 微信公众号 / 服务号 ----------
WX_MP_APPID=
WX_MP_SECRET=
WX_MP_TOKEN=
WX_MP_AES_KEY=
# 接收消息的本地回调端口（需公网可访问 + 公众号后台配置）
WX_MP_PORT=8789

# ---------- QQ 官方机器人（需 QQ 开放平台审核） ----------
QQ_BOT_APPID=
QQ_BOT_TOKEN=
QQ_BOT_SECRET=

# ---------- QQ 非官方通道（OneBot / NapCat / LLOneBot，推荐用于"看图"） ----------
# 这套不走 QQ 官方审核，挂在你自己登录的 QQ 上，能收到群里所有消息（含单独发的图片）。
# 前置：在 Windows 上装好 NapCat，并在其配置里开启 OneBot WebSocket（默认 ws://127.0.0.1:3001）。
ENABLE_ONEBOT=false
# NapCat 暴露的 OneBot WebSocket 地址（端口以你本地为准）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 若 NapCat 设了 access_token 则填这里（可留空）
ONEBOT_TOKEN=
# 你的 QQ 号（用于在群里识别"被 @"，填了才会只在被 @ 时回复；不填则任何含 @昵称 的都回）
ONEBOT_BOT_QQ=
# 你的 QQ 昵称（备选的 @ 识别方式，可不填）
ONEBOT_BOT_NAME=
# 需要"不 @ 也自动回复"的群号列表，用英文逗号分隔（如 123456789,987654321）；留空则群聊只回复 @
ONEBOT_ALLOW_GROUPS=
