# 可选：让 nexus_chat 工具能调用你的模型（本地模型可留空密钥）
# 复制本文件为 .env 后填写

# 例：本地 Ollama
NEXUS_CHAT_BASE_URL=http://192.168.1.100:11434/v1
NEXUS_CHAT_MODEL=qwen3
NEXUS_CHAT_API_KEY=

# ===== 云端 HTTP 模式（可选）=====
# 设为 http 即启用云端 HTTP 服务（默认 stdio 本地模式）
TRANSPORT=http
# 监听端口
PORT=8787
# 访问密钥：Claude Code 配置时填 Bearer <MCP_TOKEN>
MCP_TOKEN=你的随机密钥
