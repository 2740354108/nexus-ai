# NEXUS MCP 服务配置示例
# 复制为 .env 后按需修改

# 传输模式：stdio（Claude Code 等本地客户端直连，推荐）或 http（远程暴露）
TRANSPORT=stdio

# HTTP 模式专用（stdio 模式忽略这两项）
PORT=8787
# 远程暴露时建议设一个令牌，客户端需用 Bearer 携带；留空则无鉴权（公网请勿留空）
MCP_TOKEN=

# ===== 对话能力（nexus_chat 工具用）=====
# 指向本机 NEXUS 后端的 OpenAI 兼容接口（后端会套用 NEXUS LAB 人设）
NEXUS_CHAT_BASE_URL=http://localhost:3000/api/ai/v1
# 该字段后端实际按自己配置的模型链路由，这里填任意非空值即可（占位）
NEXUS_CHAT_MODEL=nexus-auto
# 本地后端若设了 AI_BOT_TOKEN，填到这里即可免登录调用；否则需在后端 register/login 拿 JWT
# 注意：AI_BOT_TOKEN 是站长的「公开中继 / 自有网关」令牌，仅本机自用时填
NEXUS_CHAT_API_KEY=
